N_RUNS=10
REPEATABILITY_THRESHOLD=1.0
JACCARD_THRESHOLD=0.95
REPORT_DIR=reports

# === LLM provider =================================================
# stub    - deterministic, no network (default; CI-safe)
# bedrock - AWS Bedrock via aioboto3 (requires AWS creds + aioboto3)
LLM_PROVIDER=stub

# === AWS Bedrock (only used when LLM_PROVIDER=bedrock) ============
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_TEMPERATURE=0.0
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY read from your usual AWS chain

# === API clients ==================================================
# Future: API_BASE_URL=http://localhost:8080
API_BASE_URL=stub
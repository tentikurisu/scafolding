# =====================================================================
# .env.example - placeholder names only. No real secrets.
# Copy to .env and fill in actual values. .env is in .gitignore.
# =====================================================================

# === Production handler override ===================================
# Default: the placeholder in tests/functional/project_adapter.py is used.
# Override: EXECUTION_HANDLER_PATH=my_project.execution:lambda_handler
EXECUTION_HANDLER_PATH=

# === Deployed Lambda tests (opt-in) ================================
# Set to "true" to enable deployed-marked tests.
# Without this, an ordinary pytest run never contacts AWS.
RUN_DEPLOYED_FUNCTIONAL_TESTS=false

EXECUTION_LAMBDA_NAME=
AWS_REGION=us-east-1

# === AWS credentials ===============================================
# Read by boto3 from the standard chain (env, ~/.aws/credentials, IAM).
# NEVER commit credentials.
# =====================================================================
# .env.example — PLACEHOLDER NAMES ONLY. No real values.
# Copy to .env and fill in your actual values. .env is in .gitignore.
# =====================================================================

# Which system-under-test to run against.
#   mock    - LocalMockSystem (default, no AWS needed)
#   lambda  - AwsLambdaSystem (requires AWS creds + Lambda name)
TEST_TARGET=mock

# === AWS / Lambda config (only used when TEST_TARGET=lambda) =========
AWS_REGION=us-east-1
EXECUTION_LAMBDA_NAME=
EXECUTION_LAMBDA_ALIAS=

# === Repeatability thresholds ========================================
FUNCTIONAL_RUN_COUNT=10
FUNCTIONAL_MINIMUM_PASS_RATE=0.9

# === Optional: independent API adapter (HTTP) ======================
# Used by tests/integration/test_api_contract.py (not yet included).
# DO NOT put real credentials here; .env is gitignored.
API_BASE_URL=
API_AUTH_HEADER=

# === AWS credentials are read by boto3 from the standard chain =======
# (env vars, ~/.aws/credentials, IAM role). Never commit them.

# === Bedrock (used by BedrockLLM if you swap MockLLM for it) =========
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_TEMPERATURE=0.0